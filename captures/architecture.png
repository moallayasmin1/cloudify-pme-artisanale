<script src="./architecture_files/viz-global.js.téléchargement"></script>
<script type="module">
	import { render } from "https://plantuml.github.io/plantuml/js-plantuml/plantuml.js";
	const renderOptions = {};
	const textarea = document.getElementById("src");
	function renderNow() {
		render(textarea.value.split(/\r\n|\r|\n/), "out", renderOptions);
	}
	textarea.addEventListener("input", renderNow);
	renderNow();
</script>


<a style="position:relative;top:-38px;" name="3928870aae1e447d"></a>
<!--heading--><h1 class="chap"><div class="dropdown"><button class="dropbtn"><img width="16" height="16" src="./architecture_files/edit1.svg"></button><div class="dropdown-content"><a href="http://alphadoc.plantuml.com/cmp/dokuwiki/fr/index#0"><img width="20" height="20" src="./architecture_files/dokuwiki.png">Edit in Dokuwiki</a><a href="http://alphadoc.plantuml.com/cmp/asciidoc/fr/index#0"><img width="20" height="20" src="./architecture_files/asciidoc32.png">Edit in Asciidoc</a><a href="http://alphadoc.plantuml.com/cmp/markdown/fr/index#0"><img width="20" height="20" src="./architecture_files/markdown.png">Edit in Markdown</a></div></div>🌱 PlantUML en un coup d'œil</h1>
<style>
