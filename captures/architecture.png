    flex-shrink: 0;
}
#ext-promo .ext-promo-text {
    flex: 1;
    min-width: 240px;
}
#ext-promo .ext-promo-links {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    flex-shrink: 0;
}
#ext-promo .ext-promo-links a {
    display: inline-block;
    padding: 5px 12px;
    border-radius: 4px;
    color: #fff;
    text-decoration: none;
    font-weight: 500;
    font-size: 13px;
    white-space: nowrap;
